{
  "redirects": [
    { "source": "/cart/c/:path*", "destination": "https://arvox-space.myshopify.com/cart/c/:path*", "permanent": false },
    { "source": "/checkouts/:path*", "destination": "https://arvox-space.myshopify.com/checkouts/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|gif|png|webp|svg|ico|woff|woff2|ttf|eot))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}